<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.medical.mapper.PrescriptionItemMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hospital.medical.entity.PrescriptionItem">
        <id column="id" property="id" />
        <result column="prescription_id" property="prescriptionId" />
        <result column="drug_name" property="drugName" />
        <result column="spec" property="spec" />
        <result column="dosage" property="dosage" />
        <result column="quantity" property="quantity" />
        <result column="unit_price" property="unitPrice" />
        <result column="usage_method" property="usageMethod" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, prescription_id, drug_name, spec, dosage, quantity, unit_price, usage_method
    </sql>

</mapper>
